# Password login dashboard (WAJIB diisi di Vercel Environment Variables & .env.local)
APP_PASSWORD=ganti-dengan-password-yang-kuat

# Kunci acak untuk menandatangani session cookie (disarankan min. 32 karakter hex)
# Contoh generate di terminal: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-random-hex-minimal-32-karakter

# URL Google Sheets CSV untuk mode Harga & Stok (WAJIB diisi jika tidak memakai GAS_WEBAPP_URL)
HARGA_SHEET_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub?gid=0&single=true&output=csv
STOK_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=0

# Opsional: Jika menggunakan Google Apps Script Web App sebagai backend
# GAS_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# GAS_BACKEND_PASSWORD=

# Opsional: Daftar origin tambahan yang diizinkan untuk CORS (pisahkan dengan koma)
# Kosongkan jika frontend dan API berada di domain yang sama (Vercel default)
# ALLOWED_ORIGINS=https://nama-project.vercel.app
